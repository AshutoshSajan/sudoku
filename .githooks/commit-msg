#!/bin/sh
# Enforces Conventional Commits so git-cliff can build the changelog.
# Enable with: git config core.hooksPath .githooks
# Format: type(scope): subject   e.g.  feat(board): add same-number highlight
# Types: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert

msg_file="$1"
subject=$(head -n1 "$msg_file")

# Allow merge commits.
case "$subject" in
  Merge\ *) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+'; then
  echo "❌ Commit rejected: message must follow Conventional Commits." >&2
  echo "   type(scope): subject   (scope optional)" >&2
  echo "   types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "   got: $subject" >&2
  exit 1
fi
